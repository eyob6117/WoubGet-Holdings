---
import '../styles/global.css';
import { group } from '../data/site';

interface Props { title?: string; description?: string; themeColor?: string }
const {
  title = `${group.name} | Transport, Logistics, Trade and Industry in Ethiopia`,
  description = 'WoubGet Holdings is a group of Ethiopian companies in air, sea and road logistics, cold-chain transport, automotive, import and distribution, sports surfaces and recycling. Explore every member company from one place.',
  themeColor = '#0a1628',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}/og.png`, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: group.legalName,
  alternateName: group.amharic,
  url: new URL(`${base}/`, Astro.site).href,
  logo: new URL(`${base}/favicon.svg`, Astro.site).href,
  email: group.email,
  telephone: group.phones[0],
  address: { '@type': 'PostalAddress', streetAddress: group.address, postOfficeBoxNumber: '1768', addressLocality: 'Addis Ababa', addressCountry: 'ET' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta name="theme-color" content={themeColor} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={group.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <a href="#main" class="sr-only z-[100] rounded-full bg-brand px-4 py-2 text-white focus:not-sr-only focus:fixed focus:top-4 focus:left-4">Skip to content</a>
    <slot />
    <script>
      // Scroll reveal
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Animated counters
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const counters = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            counters.unobserve(el);
            const target = Number(el.dataset.count);
            const decimals = Number(el.dataset.decimals ?? 0);
            const fmt = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
            if (reduce) { el.textContent = fmt(target); continue; }
            const start = performance.now();
            const dur = 1800;
            const tick = (t: number) => {
              const p = Math.min((t - start) / dur, 1);
              el.textContent = fmt(target * (1 - Math.pow(1 - p, 4)));
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }
        },
        { threshold: 0.5 }
      );
      document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => counters.observe(el));
    </script>
  </body>
</html>
