---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { group, nav, companies } from '../data/site';
import { url } from '../lib/url';
const year = new Date().getFullYear();
const half = Math.ceil(companies.length / 2);
---

<footer class="relative overflow-hidden bg-ink text-cream">
  <div class="container-x py-20">
    <div class="flex flex-col justify-between gap-10 border-b border-white/10 pb-16 lg:flex-row lg:items-end">
      <h2 class="display max-w-3xl text-5xl leading-[1] sm:text-6xl lg:text-7xl">Ten companies. <em class="text-sky italic">One</em> partner.</h2>
      <a href={url('/#contact')} class="btn-primary shrink-0 !px-8 !py-4 text-base">Get in touch <Icon name="arrow" class="h-5 w-5" /></a>
    </div>

    <div class="grid gap-12 pt-16 sm:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Logo tone="light" />
        <p class="mt-6 max-w-xs text-sm leading-relaxed text-cream/55">{group.tagline}</p>
        <p class="mt-4 text-sm text-cream/55">{group.address}<br />{group.poBox}</p>
      </div>
      <div class="lg:col-span-2">
        <h3 class="text-xs font-semibold tracking-[0.16em] text-cream/45 uppercase">Explore</h3>
        <ul class="mt-5 space-y-3 text-sm text-cream/75">
          {nav.map((n) => <li><a href={url(n.href)} class="hover:text-white">{n.label}</a></li>)}
        </ul>
      </div>
      <div class="sm:col-span-2 lg:col-span-6">
        <h3 class="text-xs font-semibold tracking-[0.16em] text-cream/45 uppercase">Our companies</h3>
        <div class="mt-5 grid gap-x-8 sm:grid-cols-2">
          {[companies.slice(0, half), companies.slice(half)].map((col) => (
            <ul class="space-y-3 text-sm text-cream/75">
              {col.map((c) => (
                <li class="flex items-center gap-2">
                  <a href={url(`/companies/${c.slug}/`)} class="hover:text-white">{c.name}</a>
                  {c.website && <a href={c.website} target="_blank" rel="noopener" class="text-sky hover:text-white" aria-label={`${c.name} website (opens in a new tab)`}><Icon name="external" class="h-3.5 w-3.5" /></a>}
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-6 border-t border-white/10 pt-8 text-xs text-cream/45 lg:flex-row lg:items-center lg:justify-between">
      <p>© {year} {group.legalName}. All rights reserved.</p>
      <p class="flex flex-wrap gap-x-4 gap-y-1"><a href={`mailto:${group.email}`} class="hover:text-white">{group.email}</a><span>{group.web}</span></p>
    </div>
  </div>
  <p aria-hidden="true" class="pointer-events-none -mb-[0.22em] text-center font-display text-[19vw] leading-none tracking-tight text-white/[0.04] select-none">WoubGet</p>
</footer>
