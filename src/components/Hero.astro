---
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import CompanyBadge from './CompanyBadge.astro';
import { companies, group, sectors } from '../data/site';
import { url } from '../lib/url';

// Place member companies evenly around the group emblem.
const orbit = companies.map((c, i) => {
  const a = (i / companies.length) * Math.PI * 2 - Math.PI / 2;
  return { c, left: 50 + 43 * Math.cos(a), top: 50 + 43 * Math.sin(a), labelBelow: Math.sin(a) > 0.2 };
});
---

<section id="top" class="grain relative isolate overflow-hidden bg-ink pt-[76px] text-cream lg:flex lg:min-h-[max(100svh,820px)] lg:flex-col lg:pt-[112px]">
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <div class="absolute -top-40 right-[-10%] h-[720px] w-[720px] rounded-full bg-brand/25 blur-[140px]"></div>
    <div class="absolute bottom-[-20%] left-[-10%] h-[520px] w-[520px] rounded-full bg-steel/70 blur-[120px]"></div>
    <svg class="absolute inset-0 h-full w-full opacity-[0.07]" aria-hidden="true">
      <defs><pattern id="grid" width="64" height="64" patternUnits="userSpaceOnUse"><path d="M64 0H0V64" fill="none" stroke="#fff" stroke-width="1" /></pattern></defs>
      <rect width="100%" height="100%" fill="url(#grid)" />
    </svg>
  </div>

  <div class="container-x grid items-center gap-14 pt-12 pb-16 lg:flex-1 lg:grid-cols-12 lg:gap-8 lg:pt-10 lg:pb-14">
    <div class="lg:col-span-6">
      <p class="eyebrow text-sky" data-reveal>{group.name} · <span lang="am">{group.amharic}</span></p>
      <h1 class="display mt-6 text-[clamp(2.6rem,4.6vw,4.1rem)] leading-[1.02]" data-reveal style="--delay:80ms">
        One group. Ten companies. <em class="text-sky italic">Connecting</em> Ethiopia to the world.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-cream/70" data-reveal style="--delay:160ms">
        WoubGet Holdings brings together companies in transport and logistics, automotive, trade and modern services, combining a global network of partners with deep experience on the ground in Ethiopia.
      </p>
      <div class="mt-10 flex flex-wrap gap-3" data-reveal style="--delay:240ms">
        <a href={url('/#companies')} class="btn-primary">Explore our companies <Icon name="arrow" class="h-4 w-4" /></a>
        <a href={url('/#about')} class="btn-ghost-light">About the group</a>
      </div>
      <ul class="mt-12 flex max-w-xl flex-wrap gap-2 border-t border-white/10 pt-8" data-reveal style="--delay:320ms">
        {sectors.map((s) => (
          <li class="rounded-full border border-white/15 px-3.5 py-1.5 text-xs font-medium text-cream/70">{s.name}</li>
        ))}
      </ul>
    </div>

    <div class="relative hidden lg:col-span-6 lg:block" data-reveal style="--delay:200ms">
      <div class="relative mx-auto aspect-square w-full max-w-[560px]">
        <svg viewBox="0 0 100 100" class="absolute inset-0 h-full w-full" aria-hidden="true">
          <g class="origin-center animate-spin-slow">
            <circle cx="50" cy="50" r="43" fill="none" stroke="#fff" stroke-opacity=".16" stroke-width=".25" stroke-dasharray="1 1.6" />
          </g>
          <circle cx="50" cy="50" r="28" fill="none" stroke="#fff" stroke-opacity=".08" stroke-width=".25" />
          <circle cx="50" cy="50" r="16" fill="#1f74c0" fill-opacity=".12" />
          {orbit.map((o) => (
            <line x1="50" y1="50" x2={o.left} y2={o.top} stroke="#9cc4e8" stroke-opacity=".14" stroke-width=".2" />
          ))}
        </svg>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-center">
          <Mark class="mx-auto h-24 w-24 drop-shadow-[0_20px_40px_rgba(31,116,192,0.45)]" />
          <p class="mt-3 font-display text-lg">WoubGet</p>
          <p class="text-[0.6rem] font-semibold tracking-[0.42em] text-sky/80 uppercase">Holdings</p>
        </div>
        <ul>
          {orbit.map((o) => (
            <li class="absolute -translate-x-1/2 -translate-y-1/2" style={`left:${o.left}%;top:${o.top}%`}>
              <a href={url(`/companies/${o.c.slug}/`)} class="group/node relative flex flex-col items-center">
                <CompanyBadge company={o.c} class="h-14 w-14 ring-4 ring-ink transition duration-500 ease-out-expo group-hover/node:scale-110 group-focus-visible/node:scale-110" />
                <span class:list={['pointer-events-none absolute left-1/2 w-max max-w-[11rem] -translate-x-1/2 rounded-full bg-white px-3 py-1 text-xs font-semibold text-ink opacity-0 shadow-lg transition duration-300 group-hover/node:opacity-100 group-focus-visible/node:opacity-100', o.labelBelow ? 'top-[calc(100%+8px)]' : 'bottom-[calc(100%+8px)]']}>
                  {o.c.name}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="relative mt-auto border-t border-white/10 bg-ink py-6">
    <div class="container-x flex items-center gap-8">
      <p class="hidden shrink-0 text-xs font-medium tracking-[0.14em] text-cream/45 uppercase md:block">Member companies</p>
      <div class="relative overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_10%,#000_90%,transparent)]">
        <ul class="flex w-max animate-marquee gap-12 pr-12 text-sm font-semibold tracking-wide text-cream/65">
          {[...companies, ...companies].map((c, i) => (
            <li class="flex items-center gap-3 whitespace-nowrap" aria-hidden={i >= companies.length ? 'true' : undefined}>
              <span class="h-1.5 w-1.5 rounded-full" style={`background:${c.accent}`}></span>{c.name}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
