---
import { groupStats, values } from '../data/site';
---

<section id="about" class="relative py-24 lg:py-32">
  <div class="container-x">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow text-brand" data-reveal>Who we are</p>
        <h2 class="display mt-5 text-4xl leading-[1.05] sm:text-5xl" data-reveal>
          A dynamic team of companies in <em class="italic">complementary</em> sectors.
        </h2>
      </div>
      <div class="space-y-6 text-lg leading-relaxed text-ink/70 lg:col-span-6 lg:col-start-7" data-reveal style="--delay:100ms">
        <p>
          WoubGet Holdings specialises in transportation and logistics as well as modern service provision. Its members include Tradepath International, Flowerport Transport, Honest Logistics, Crystal Automotive, BMW Ethiopia, Logix Express, GCC Sport Surfaces Ethiopia, Dealmode Importer, Dun Soft Drinks Distributor and EcoGuard Manufacturing.
        </p>
        <p>
          We aim to be a trailblazer in introducing unique industries to Ethiopia, combining our global network of partners with our experience on the ground to ensure their success. We are proud to present to clients and partners the full range of products and services offered by our members, all from one place.
        </p>
      </div>
    </div>

    <dl class="mt-20 grid gap-px overflow-hidden rounded-3xl border border-ink/8 bg-ink/8 sm:grid-cols-2 lg:grid-cols-4">
      {groupStats.map((s, i) => (
        <div class="bg-cream p-8 lg:p-10" data-reveal style={`--delay:${i * 80}ms`}>
          <dd class="display text-5xl whitespace-nowrap text-ink xl:text-6xl">
            <span data-count={s.value}>{s.value}</span><span class="text-brand">{s.suffix}</span>
          </dd>
          <dt class="mt-4 max-w-[16rem] text-sm leading-relaxed text-ink/60">{s.label}</dt>
        </div>
      ))}
    </dl>

    <div class="mt-24 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {values.map((v, i) => (
        <div class="rounded-3xl border border-ink/8 bg-white/70 p-8" data-reveal style={`--delay:${i * 80}ms`}>
          <span class="font-display text-sm text-brand">0{i + 1}</span>
          <h3 class="mt-8 text-xl font-semibold">{v.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink/60">{v.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
