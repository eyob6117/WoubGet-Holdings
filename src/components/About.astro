---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import headquarters from '../assets/headquarters.jpg';
import { group, groupStats, values } from '../data/site';
---

<section id="about" class="relative py-24 lg:py-32">
  <div class="container-x">
    <div class="grid gap-14 lg:grid-cols-12 lg:items-center lg:gap-16">
      <figure class="relative lg:order-last lg:col-span-6" data-reveal>
        <div class="overflow-hidden rounded-[2rem] shadow-[0_40px_80px_-40px_rgba(10,22,40,0.55)]">
          <Picture
            src={headquarters}
            formats={['avif', 'webp']}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 1024px) 46vw, 100vw"
            alt="WoubGet Holdings headquarters: a glass and stone office building with ground-floor shopfronts, near Urael Church in Addis Ababa"
            class="aspect-[4/5] w-full object-cover object-[60%_center] sm:aspect-[4/3] lg:aspect-[4/5]"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="absolute right-4 bottom-4 left-4 flex items-center gap-4 rounded-2xl border border-white/40 bg-white/85 p-4 backdrop-blur-md sm:right-auto sm:left-6 sm:bottom-6 sm:max-w-xs">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-ink text-cream"><Icon name="pin" /></span>
          <span class="text-sm leading-snug">
            <span class="block font-semibold">Our headquarters</span>
            <span class="text-ink/60">{group.address.replace(', Ethiopia', '')}</span>
          </span>
        </figcaption>
      </figure>

      <div class="lg:col-span-6">
        <p class="eyebrow text-brand" data-reveal>Who we are</p>
        <h2 class="display mt-5 text-4xl leading-[1.05] sm:text-5xl" data-reveal>
          Built in Ethiopia, <em class="italic">connected</em> to the world.
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-ink/70" data-reveal style="--delay:100ms">
          WoubGet grew from logistics into the services a growing economy needs. Each of our companies works alongside a global leader, so that expertise takes root in Ethiopia.
        </p>
        <ul class="mt-10 space-y-6 border-t border-ink/10 pt-8">
          {values.map((v, i) => (
            <li class="flex gap-5" data-reveal style={`--delay:${i * 80}ms`}>
              <span class="font-display text-sm text-brand">0{i + 1}</span>
              <div>
                <h3 class="font-semibold">{v.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-ink/60">{v.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <dl class="mt-20 grid gap-px overflow-hidden rounded-3xl border border-ink/8 bg-ink/8 sm:grid-cols-2 lg:grid-cols-4">
      {groupStats.map((s, i) => (
        <div class="bg-cream p-8 lg:p-10" data-reveal style={`--delay:${i * 80}ms`}>
          <dd class="display text-5xl whitespace-nowrap text-ink xl:text-6xl">
            <span data-count={s.value}>{s.value}</span><span class="text-brand">{s.suffix}</span>
          </dd>
          <dt class="mt-4 max-w-[16rem] text-sm leading-relaxed text-ink/60">{s.label}</dt>
        </div>
      ))}
    </dl>
  </div>
</section>
