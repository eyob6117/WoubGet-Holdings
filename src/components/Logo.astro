---
import Mark from './Mark.astro';
interface Props { class?: string; tone?: 'light' | 'dark' }
const { class: className, tone = 'dark' } = Astro.props;
const word = tone === 'light' ? '#f7f5f0' : '#10264a';
const sub = tone === 'light' ? '#9cc4e8' : '#1f74c0';
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <Mark class="h-10 w-10 shrink-0" />
  <span class="leading-none">
    <span class="block font-display text-[1.45rem] font-medium tracking-tight" style={`color:${word}`}>WoubGet</span>
    <span class="mt-1 block text-[0.6rem] font-semibold tracking-[0.42em] uppercase" style={`color:${sub}`}>Holdings</span>
  </span>
</span>
