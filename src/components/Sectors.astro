---
import Icon from './Icon.astro';
import CompanyBadge from './CompanyBadge.astro';
import { sectors, companies } from '../data/site';
import { url } from '../lib/url';
const icons = { truck: 'truck', car: 'car', box: 'box', factory: 'factory' } as const;
---

<section id="sectors" class="relative bg-ink py-24 text-cream lg:py-32">
  <div class="container-x">
    <div class="max-w-3xl">
      <p class="eyebrow text-sky" data-reveal>What we do</p>
      <h2 class="display mt-5 text-4xl leading-[1.05] sm:text-5xl" data-reveal>Four sectors, one connected group.</h2>
    </div>
    <div class="mt-16 grid gap-px overflow-hidden rounded-3xl border border-white/10 bg-white/10 md:grid-cols-2 xl:grid-cols-4">
      {sectors.map((s, i) => (
        <div class="flex flex-col bg-ink p-8 transition duration-500 hover:bg-navy" data-reveal style={`--delay:${i * 80}ms`}>
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-white/5 text-sky"><Icon name={icons[s.icon]} class="h-6 w-6" /></span>
          <h3 class="mt-10 text-2xl font-semibold">{s.name}</h3>
          <p class="mt-3 text-sm leading-relaxed text-cream/60">{s.body}</p>
          <ul class="mt-8 space-y-2 border-t border-white/10 pt-6">
            {companies.filter((c) => c.sector === s.name).map((c) => (
              <li>
                <a href={url(`/companies/${c.slug}/`)} class="group flex items-center gap-3 text-sm text-cream/80 hover:text-white">
                  <CompanyBadge company={c} class="h-7 w-7 !rounded-lg !text-[0.55rem]" />
                  <span class="flex-1">{c.name}</span>
                  <Icon name="arrowUpRight" class="h-4 w-4 opacity-0 transition group-hover:opacity-100" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
